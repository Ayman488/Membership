@model Membership.Models.User
@{
    ViewData["Title"] = "تعديل بيانات المستخدم"; // تم التعديل
}

<div class="container mt-4">
    <h2>تعديل بيانات الطالب: @Model.FirstName @Model.LastName</h2> <form asp-action="EditUser" method="post" class="mt-4">
        <input type="hidden" name="id" value="@Model.UserId" /> <div class="form-group mb-3">
            <label>الكلية</label>
            <input type="text" name="college" class="form-control" value="@Model.College" required />
        </div>

        <div class="form-group mb-3">
            <label>السنة الدراسية</label>
            <select name="yearOfStudy" class="form-control">
                <option value="1" selected="@(Model.YearOfStudy == "1")">السنة الأولى</option>
                <option value="2" selected="@(Model.YearOfStudy == "2")">السنة الثانية</option>
                <option value="3" selected="@(Model.YearOfStudy == "3")">السنة الثالثة</option>
                <option value="4" selected="@(Model.YearOfStudy == "4")">السنة الرابعة</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">حفظ التغييرات</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
    </form>
</div>