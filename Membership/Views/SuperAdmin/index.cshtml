@model Membership.Models.SuperAdminIndexViewModel
@{
    // الآن نجلب البيانات مباشرة من الموديل الذي أرسلته في الكنترولر
    var admins = Model.Admins ?? new List<Membership.Models.Admin>();
    var activeUsers = Model.ActiveUsers ?? new List<Membership.Models.User>();
    var pendingUsers = Model.PendingUsers ?? new List<Membership.Models.User>();
    var graduatedUsers = activeUsers.Where(u => u.IsGrad()).ToList();
    var currentActiveStudents = activeUsers.Where(u => !u.IsGrad()).ToList();
}

@if (TempData["ErrorMessage"] != null)
{
    <script>alert('@Html.Raw(TempData["ErrorMessage"])');</script>
}
@if (TempData["SuccessMessage"] != null)
{
    <script>alert('@Html.Raw(TempData["SuccessMessage"])');</script>
}

<div class="container mt-4" dir="rtl" style="text-align: right;">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="text-primary">إدارة النظام - @(User.IsInRole("SuperAdmin") ? "سوبر أدمن" : "مشرف")</h2>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger shadow-sm">تسجيل الخروج</a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>قائمة المشرفين (Admins)</h3>
        @if (User.IsInRole("SuperAdmin"))
        {
            <div class="d-flex gap-2">
                <a asp-action="UploadStudents" class="btn btn-primary shadow-sm">
                    <i class="bi bi-file-earmark-excel"></i> رفع بيانات طلاب (Excel)
                </a>
                <a asp-action="Create" class="btn btn-success shadow-sm">إضافة مشرف جديد</a>
            </div>
        }
    </div>

    <table class="table table-bordered table-hover text-center shadow-sm mb-5">
        <thead class="table-dark">
            <tr><th>الاسم</th><th>البريد</th><th>الرتبة</th><th>العمليات</th></tr>
        </thead>
        <tbody>
            @foreach (var admin in admins)
            {
                <tr class="@(admin.Email == User.Identity.Name ? "table-info" : "")">
                    <td>@admin.Name</td>
                    <td>@admin.Email</td>
                    <td>@admin.Role</td>
                    <td>
                        @if (admin.Email == User.Identity.Name)
                        {
                            <span class="badge bg-primary p-2">حسابك الحالي</span>
                        }
                        else if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="d-flex gap-2 justify-content-center">
                                <form asp-action="PromoteToSuperAdmin" asp-route-id="@admin.AdminId" method="post" onsubmit="return confirm('هل أنت متأكد من نقل ملكية السوبر أدمن لهذا الشخص؟');">
                                    <button type="submit" class="btn btn-info btn-sm text-white shadow-sm">ترقية لسوبر</button>
                                </form>
                                <form asp-action="DeleteAdmin" asp-route-id="@admin.AdminId" method="post" onsubmit="return confirm('حذف هذا المشرف نهائياً؟');">
                                    <button type="submit" class="btn btn-danger btn-sm shadow-sm">حذف</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">صلاحية محدودة</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr class="my-5" />
    <div class="row mb-4 text-center">
        <div class="col-md-4">
            <div class="card border-success shadow-sm">
                <div class="card-body">
                    <h5 class="text-success">الطلاب الحاليين</h5>
                    <p class="h3">@currentActiveStudents.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-primary shadow-sm">
                <div class="card-body">
                    <h5 class="text-primary">الأعضاء المتخرجون</h5>
                    <p class="h3">@graduatedUsers.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-danger shadow-sm">
                <div class="card-body">
                    <h5 class="text-danger">بانتظار التفعيل</h5>
                    <p class="h3">@pendingUsers.Count()</p>
                </div>
            </div>
        </div>
    </div>

    <h3 class="text-danger mb-3">منتسبون قيد الانتظار</h3>
    <table class="table table-hover table-bordered text-center shadow-sm mb-5">
        <thead class="table-danger">
            <tr>
                <th>الاسم</th>
                <th>الجنس</th>
                <th>البريد</th>
                <th>الرقم الجامعي</th>
                <th>الهاتف</th>
                <th>الجامعة</th>
                <th>التخصص</th>
                <th>السنة</th>
                <th>البطاقة</th>
                <th>العمليات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in pendingUsers)
            {
                <tr>
                    <td>@user.FirstName @user.LastName</td>
                    <td>@user.gender</td>
                    <td>@user.Email</td>
                    <td>@user.StudentNumber</td>
                    <td>@user.PhoneNumber</td>
                    <td>@user.University</td>
                    <td>@user.College</td>
                    <td>@user.YearOfStudy</td>
                    <td>
                        @if (!string.IsNullOrEmpty(user.StudentCartPhoto))
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    onclick="showImage('/images/students/@user.StudentCartPhoto')">
                                <i class="bi bi-image"></i> عرض
                            </button>
                        }
                        else
                        {
                            <span class="text-muted small">لا توجد</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2 justify-content-center">
                            <form asp-action="ActivateUser" asp-route-id="@user.UserId" method="post">
                                <button type="submit" class="btn btn-success btn-sm">تفعيل</button>
                            </form>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <form asp-action="DeleteUser" asp-route-id="@user.UserId" method="post" onsubmit="return confirm('حذف؟');">
                                    <button type="submit" class="btn btn-danger btn-sm">حذف</button>
                                </form>
                                <form id="customEmailForm-active-@user.UserId" asp-action="SendCustomEmail" asp-route-id="@user.UserId" method="post" style="display:inline;">
                                    @* // تم التعديل نسخة 2 *@
                                    <input type="hidden" name="customMessage" id="customMessage-active-@user.UserId" /> @* // تم التعديل نسخة 2 *@
                                    <button type="button" class="btn btn-sm btn-primary px-3 fw-bold" onclick="promptAndSendEmail('active', @user.UserId)">ارسال ايميل</button> @* // تم التعديل نسخة 2 *@
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="text-success mb-3">المنتسبون المقبولون</h3>
    <table class="table table-striped table-bordered text-center shadow-sm">
        <thead class="table-primary">
            <tr>
                <th>#</th>
                <th>الاسم</th>
                <th>الجنس</th>
                <th>البريد</th>
                <th>الرقم الجامعي</th>
                <th>الهاتف</th>
                <th>الجامعة</th>
                <th>التخصص</th>
                <th>السنة</th>
                <th>البطاقة</th>
                <th>العمليات</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
            }
            @foreach (var user in currentActiveStudents)
            {
                <tr>
                    <td>@i</td>
                    <td>@user.FirstName @user.LastName</td>
                    <td>@user.gender</td>
                    <td>@user.Email</td>
                    <td>@user.StudentNumber</td>
                    <td>@user.PhoneNumber</td>
                    <td>@user.University</td>
                    <td>@user.College</td>
                    <td>@user.YearOfStudy</td>
                    <td>
                        @if (!string.IsNullOrEmpty(user.StudentCartPhoto))
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    onclick="showImage('/images/students/@user.StudentCartPhoto')">
                                <i class="bi bi-image"></i> عرض
                            </button>
                        }
                        else
                        {
                            <span class="text-muted small">لا توجد</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1 justify-content-center align-items-center">
                            <a asp-action="EditUser" asp-route-id="@user.UserId"
                               class="btn btn-warning btn-sm text-white fw-bold text-nowrap"
                               style="width: 85px; font-size: 0.75rem;">تعديل</a>

                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <form asp-action="GraduateMember" asp-route-id="@user.UserId" method="post" class="m-0 p-0">
                                    <button type="submit" class="btn btn-success btn-sm fw-bold text-nowrap"
                                            style="width: 85px; font-size: 0.75rem;">
                                        تخرج
                                    </button>
                                </form>

                                <form asp-action="DeactivateUser" asp-route-id="@user.UserId" method="post" class="m-0 p-0">
                                    <button type="submit" class="btn btn-outline-danger btn-sm fw-bold shadow-sm text-nowrap"
                                            style="width: 85px; font-size: 0.75rem;">
                                        تعليق
                                    </button>
                                </form>

                                <form asp-action="DeleteUser" asp-route-id="@user.UserId" method="post"
                                      onsubmit="return confirm('حذف نهائياً؟');" class="m-0 p-0">
                                    <button type="submit" class="btn btn-danger btn-sm fw-bold text-nowrap"
                                            style="width: 85px; font-size: 0.75rem;">
                                        حذف
                                    </button>
                                </form>
                                <form id="customEmailForm-active-@user.UserId" asp-action="SendCustomEmail" asp-route-id="@user.UserId" method="post"
                                      class="m-0 p-0" ">
                                    @* // تم التعديل نسخة 2 *@
                                    <input type="hidden" name="customMessage" id="customMessage-active-@user.UserId" /> @* // تم التعديل نسخة 2 *@
                                    <button type="button" class="btn btn-sm btn-primary px-3 fw-bold" onclick="promptAndSendEmail('active', @user.UserId)">ارسال ايميل</button> @* // تم التعديل نسخة 2 *@
                                </form>
                            }
                        </div>
                    </td>
                </tr>
                i++;
            }
        </tbody>
    </table>

    <h3 class="text-primary mb-3"><i class="bi bi-mortarboard"></i> الأعضاء المتخرجين</h3>
    <div class="table-responsive">
        <table class="table table-hover table-bordered text-center shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>الاسم الكامل</th>
                    <th>رقم الطالب</th>
                    <th>الهاتف</th>
                    <th>البريد الإلكتروني</th>
                    <th>الجامعة / الكلية</th>
                    <th>الحالة</th>
                    <th>الكرت</th>
                    <th>العمليات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in graduatedUsers)
                {
                    <tr>
                        <td class="fw-bold">@user.FirstName @user.LastName</td>
                        <td><span class="badge bg-secondary">@user.StudentNumber</span></td>
                        <td dir="ltr">@user.PhoneNumber</td>
                        <td><small>@user.Email</small></td>
                        <td>@user.University <br /> <small class="text-muted">@user.College</small></td>
                        <td><span class="badge bg-info text-dark">خريج</span></td>
                        <td>
                            <button class="btn btn-sm btn-light border" onclick="showImage('/images/students/@user.StudentCartPhoto')">👁️</button>
                        </td>
                        <td>
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-action="EditUser" asp-route-id="@user.UserId" class="btn btn-warning btn-sm text-white">تعديل</a>
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <form asp-action="DeleteUser" asp-route-id="@user.UserId" method="post" onsubmit="return confirm('حذف نهائياً؟');">
                                        <button type="submit" class="btn btn-danger btn-sm">حذف</button>
                                    </form>
                                    <form asp-action="UndergraduateMember" asp-route-id="@user.UserId" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-success px-3 fw-bold">إلغاء التخرج</button>
                                    </form>
                                }
                            </div>
                        </td>
                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Modal Preview *@
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">معاينة بطاقة الطالب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" class="img-fluid rounded" alt="بطاقة الطالب" />
            </div>
        </div>
    </div>
</div>

<script>
    function showImage(src) {
        var modalImg = document.getElementById('modalImage');
        modalImg.src = src;
        modalImg.onerror = function() {
            console.error("تعذر العثور على الصورة في المسار: " + src);
        };
        var myModal = new bootstrap.Modal(document.getElementById('imageModal'));
        myModal.show();
    }
</script>